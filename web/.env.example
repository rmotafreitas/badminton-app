# Google OAuth — must match GOOGLE_CLIENT_ID in backend/.env
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend API base URL — used ONLY by Vite's dev proxy in local dev.
# In production (Vercel), this is unused; Vercel's edge uses the
# server-side API_URL env var instead (see web/vercel.json).
VITE_API_URL=https://localhost:3000

# Runtime mode: "local" = local HTTPS via mkcert | "vercel" = no dev plugins (Vercel TLS)
IN_DEV=local
