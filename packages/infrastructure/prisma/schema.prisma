// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model User {
    id           String    @id @default(auto()) @map("_id") @db.ObjectId
    email        String?
    phone        String?
    passwordHash String?
    roles        Role[]    @default([PLAYER])
    eloSingles   Float     @default(200)
    eloDoubles   Float     @default(200)
    isActive     Boolean   @default(true)
    lastAccess   DateTime?
    clubId       String?   @db.ObjectId
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt

    authMethods     AuthMethod[]
    sessions        AuthSession[]
    profile         Profile?
    club            Club?        @relation(fields: [clubId], references: [id])
    registeredGames Game[]       @relation("GameRegistrar")
    trainingReviews TrainingSessionReview[]
    memberDetails   MemberDetails?
    registrations   Registration[]

    @@index([email])
    @@index([phone])
    @@index([clubId])
}

model Profile {
    id        String    @id @default(auto()) @map("_id") @db.ObjectId
    userId    String    @unique @db.ObjectId
    name      String
    birthday  DateTime?
    sex       String?
    photo     String?
    banner    String?
    /// Content hash of `photo` / `banner`: part of the image URL so browsers cache it forever.
    photoVersion  String?
    bannerVersion String?
    bio       String?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Club {
    id             String   @id @default(auto()) @map("_id") @db.ObjectId
    name           String
    location       String?
    profilePicture String?
    banner         String?
    /// Content hash of `profilePicture` / `banner` (see Profile.photoVersion).
    pictureVersion String?
    bannerVersion  String?
    /// The club's registration form text (season, fee, declaration, footer). Null = the default form.
    registrationForm Json?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    users         User[]
    games         Game[]
    registrations Registration[]
}

enum GameType {
    SINGLES
    DOUBLES
}

type GameSet {
    team1Score Int
    team2Score Int
}

model Game {
    id             String    @id @default(auto()) @map("_id") @db.ObjectId
    type           GameType
    clubId         String    @db.ObjectId
    team1PlayerIds String[]  @db.ObjectId
    team2PlayerIds String[]  @db.ObjectId
    sets           GameSet[]
    registeredById String    @db.ObjectId
    playedAt       DateTime  @default(now())
    createdAt      DateTime  @default(now())

    club         Club @relation(fields: [clubId], references: [id])
    registeredBy User @relation("GameRegistrar", fields: [registeredById], references: [id])

    @@index([clubId, playedAt])
    @@index([team1PlayerIds])
    @@index([team2PlayerIds])
}

model AuthMethod {
    id         String   @id @default(auto()) @map("_id") @db.ObjectId
    userId     String   @db.ObjectId
    provider   String
    providerId String
    createdAt  DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerId])
    @@index([userId])
}

/// One-time sign-in link or code. `token` holds the SHA-256 of the secret, never the secret itself.
/// `type`: "email-link" | "email-code" | "sms-code".
model MagicToken {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    token     String   @unique
    target    String
    type      String
    expiresAt DateTime
    used      Boolean  @default(false)
    createdAt DateTime @default(now())

    @@index([expiresAt])
}

/// Opaque server-side session (replaces the JWT pair). Only the token's SHA-256 is stored.
model AuthSession {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    userId    String   @db.ObjectId
    tokenHash String   @unique
    expiresAt DateTime
    userAgent String?
    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([expiresAt])
}

/// Fixed-window rate-limit counter (sign-in sends and attempts).
model RateLimitBucket {
    id          String   @id @default(auto()) @map("_id") @db.ObjectId
    key         String
    windowStart DateTime
    count       Int      @default(0)
    expiresAt   DateTime

    @@unique([key, windowStart])
    @@index([expiresAt])
}

model TrainingSessionReview {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    userId    String   @db.ObjectId
    date      String
    effort    Int
    note      String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, date])
}

// Rally Analysis: a recorded session analysed on the user's device. Video and
// frame-level analysis live in object storage (R2); this keeps the summary.
model RallySession {
    id                 String               @id @default(auto()) @map("_id") @db.ObjectId
    ownerId            String               @db.ObjectId
    clientId           String
    title              String?
    recordedAt         DateTime
    durationS          Float
    status             String               @default("pending")
    format             String?
    gameId             String?              @db.ObjectId
    trainingDate       String?
    participants       RallyParticipant[]
    participantUserIds String[]             @db.ObjectId
    videoKey           String?
    videoBytes         Int?
    videoUploadedAt    DateTime?
    videoExpiresAt     DateTime?
    pinned             Boolean              @default(false)
    resultKey          String?
    summary            Json?
    corrections        Json?
    analysisLock       RallyAnalysisLock?
    shareForTraining   Boolean              @default(false)
    createdAt          DateTime             @default(now())
    updatedAt          DateTime             @updatedAt

    @@unique([ownerId, clientId])
    @@index([participantUserIds])
    @@index([gameId])
    @@index([videoExpiresAt])
}

type RallyParticipant {
    playerId String
    userId   String @db.ObjectId
}

type RallyAnalysisLock {
    deviceId String
    until    DateTime
}

enum Role {
    SYSTEM_ADMIN
    CLUB_ADMIN
    COACH
    PLAYER
}

// Registration ("Ficha de Inscrição"): personal details the club needs, kept privately per member, and one
// registration per member, club and season with the club's side (signed copy received, approved).

type PersonalDetails {
    fullName     String?
    sex          String?
    birthday     String?
    nationality  String?
    address      String?
    locality     String?
    municipality String?
    postalCode   String?
    idNumber     String?
    idValidUntil String?
    nif          String?
    phone        String?
    email        String?
    profession   String?
}

/// Private: the member, their club's admins and system admins. Erasable by the member.
model MemberDetails {
    id        String           @id @default(auto()) @map("_id") @db.ObjectId
    userId    String           @unique @db.ObjectId
    person    PersonalDetails
    nib       String?
    guardian  PersonalDetails?
    updatedAt DateTime         @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Registration {
    id             String    @id @default(auto()) @map("_id") @db.ObjectId
    userId         String    @db.ObjectId
    clubId         String    @db.ObjectId
    season         String
    categories     String[]
    signedReceived Boolean   @default(false)
    /// Object-storage key of the signed scan (R2), when one was uploaded.
    signedFileKey  String?
    signedFileType String?
    approvedAt     DateTime?
    approvedById   String?   @db.ObjectId
    notes          String?
    createdAt      DateTime  @default(now())
    updatedAt      DateTime  @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

    @@unique([userId, clubId, season])
    @@index([clubId, season])
}
