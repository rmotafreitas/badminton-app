# ── Runtime mode ──────────────────────────────────────────────────────────────
# "local"  = long-running Bun server + local HTTPS (your machine / Docker)
# "vercel" = serverless export for Vercel Functions (Vercel handles TLS)
IN_DEV=local

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_USER=admin
MONGO_PASSWORD=changeme

# Used by Prisma (docker: use container hostname "mongo")
DATABASE_URL=mongodb://admin:changeme@localhost:27017/app?authSource=admin

# ── Registration ──────────────────────────────────────────────────────────────
# Set to "0" to disable new user creation during login.
# When disabled, only pre-existing users can sign in.
ENABLE_REGISTRATION=1

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters
JWT_SECRET=replace-with-a-secure-random-string-min-32-chars

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── SMTP (Email channel) ──────────────────────────────────────────────────────
# Gmail example — use an App Password (not your account password)
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true = implicit TLS (port 465), false = STARTTLS (port 587)
SMTP_SECURE=false
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@gmail.com
# Optional display name shown in email clients (e.g., "Badminton Buddy")
SMTP_FROM_NAME=Badminton Buddy

# ── Twilio (SMS channel — optional) ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ── App URLs ──────────────────────────────────────────────────────────────────
# Used for building magic-link URLs in emails
APP_URL=https://localhost:5173
FRONTEND_URL=https://localhost:5173

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
# Set to "false" to disable HTTPS (used inside Docker)
HTTPS=true

# ── Object storage (S3-compatible: Cloudflare R2 in prod, SeaweedFS in dev) ──
# Dev values match infra/seaweedfs/s3.json (docker-compose.dev.yml).
# R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto,
#     keys from an R2 API token scoped to the bucket. URLs are path-style.
# The bucket needs a CORS rule allowing PUT/GET from your app origin.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=rally-dev
S3_ACCESS_KEY_ID=devaccesskey
S3_SECRET_ACCESS_KEY=devsecretkey-local-only
# Phones on your LAN can't reach "localhost": to test uploads from a phone in
# dev, use your machine's LAN IP here (e.g. http://192.168.1.67:8333).

# Shared secret for the daily video-retention cron (Vercel Cron sends it as a
# Bearer token). Generate with: openssl rand -hex 32
CRON_SECRET=
