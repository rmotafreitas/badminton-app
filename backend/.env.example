# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_USER=admin
MONGO_PASSWORD=changeme

# Used by Prisma (docker: use container hostname "mongo")
DATABASE_URL=mongodb://admin:changeme@localhost:27017/app?authSource=admin

# ── Registration ──────────────────────────────────────────────────────────────
# Set to "0" to disable new user creation during login.
# When disabled, only pre-existing users can sign in.
ENABLE_REGISTRATION=1

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters
JWT_SECRET=replace-with-a-secure-random-string-min-32-chars

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── SMTP (Email channel) ──────────────────────────────────────────────────────
# Gmail example — use an App Password (not your account password)
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true = implicit TLS (port 465), false = STARTTLS (port 587)
SMTP_SECURE=false
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@gmail.com
# Optional display name shown in email clients (e.g., "Badminton App")
SMTP_FROM_NAME=Badminton App

# ── Twilio (SMS channel — optional) ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ── App URLs ──────────────────────────────────────────────────────────────────
# Used for building magic-link URLs in emails
APP_URL=https://localhost:5173
FRONTEND_URL=https://localhost:5173

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
# Set to "false" to disable HTTPS (used inside Docker)
HTTPS=true
