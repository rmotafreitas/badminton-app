{
  "name": "backend",
  "version": "2.0.0",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun run scripts/vercel-build.ts",
    "build:bundle": "bun build src/index.ts --outdir dist --target bun",
    "db:generate": "bunx --bun prisma generate",
    "db:push": "bunx --bun prisma db push",
    "db:studio": "bunx --bun prisma studio",
    "db:seed": "bun run prisma/seed.ts",
    "db:recompute-elo": "bun run scripts/recompute-elo.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@elysiajs/cors": "latest",
    "@elysiajs/swagger": "^1.3.1",
    "@prisma/client": "^6.19.3",
    "@types/sharp": "^0.32.0",
    "bcryptjs": "^3.0.3",
    "elysia": "^1.4.29",
    "elysia-local-https": "^1.0.2",
    "google-auth-library": "^9.15.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^6.10.1",
    "sharp": "^0.35.2",
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^6.4.24",
    "bun-types": "latest",
    "prisma": "^6.19.3"
  },
  "module": "src/index.js"
}