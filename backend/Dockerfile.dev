# ── Dev image — hot-reload with Bun ──────────────────────────────────────────
FROM oven/bun:latest

WORKDIR /app

COPY package.json bun.lockb* ./
RUN bun install

COPY prisma ./prisma
RUN bunx prisma generate

COPY . .

EXPOSE 3000
RUN chmod +x scripts/dev-entrypoint.sh
CMD ["scripts/dev-entrypoint.sh"]
