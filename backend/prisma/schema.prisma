// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model User {
    id           String    @id @default(auto()) @map("_id") @db.ObjectId
    email        String?
    phone        String?
    passwordHash String?
    roles        Role[]    @default([PLAYER])
    elo          Float     @default(200)
    isActive     Boolean   @default(true)
    lastAccess   DateTime?
    clubId       String?   @db.ObjectId
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt

    authMethods     AuthMethod[]
    profile         Profile?
    club            Club?        @relation(fields: [clubId], references: [id])
    registeredGames Game[]       @relation("GameRegistrar")
}

model Profile {
    id        String    @id @default(auto()) @map("_id") @db.ObjectId
    userId    String    @unique @db.ObjectId
    name      String
    birthday  DateTime?
    sex       String?
    photo     String?
    banner    String?
    bio       String?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Club {
    id             String   @id @default(auto()) @map("_id") @db.ObjectId
    name           String
    location       String?
    profilePicture String?
    banner         String?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    users User[]
    games Game[]
}

enum GameType {
    SINGLES
    DOUBLES
}

type GameSet {
    team1Score Int
    team2Score Int
}

model Game {
    id             String    @id @default(auto()) @map("_id") @db.ObjectId
    type           GameType
    clubId         String    @db.ObjectId
    team1PlayerIds String[]  @db.ObjectId
    team2PlayerIds String[]  @db.ObjectId
    sets           GameSet[]
    registeredById String    @db.ObjectId
    playedAt       DateTime  @default(now())
    createdAt      DateTime  @default(now())

    club         Club @relation(fields: [clubId], references: [id])
    registeredBy User @relation("GameRegistrar", fields: [registeredById], references: [id])
}

model AuthMethod {
    id         String   @id @default(auto()) @map("_id") @db.ObjectId
    userId     String   @db.ObjectId
    provider   String
    providerId String
    createdAt  DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerId])
    @@index([userId])
}

model MagicToken {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    token     String   @unique
    target    String
    type      String
    expiresAt DateTime
    used      Boolean  @default(false)
    createdAt DateTime @default(now())
}

enum Role {
    SYSTEM_ADMIN
    CLUB_ADMIN
    COACH
    PLAYER
}
