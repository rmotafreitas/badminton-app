{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../.tsbuild/web",
    "rootDir": "src",
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "types": [
      "vite/client",
      "@webgpu/types"
    ],
    "tsBuildInfoFile": "../../.tsbuild/web.tsbuildinfo",
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/features/rally/_old-*"
  ],
  "references": [
    {
      "path": "../../packages/contracts"
    },
    {
      "path": "../api"
    }
  ]
}
