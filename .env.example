# One .env at the repository root, read by the API (bun --env-file) and the web app (Vite envDir).

# ── Database (MongoDB, replica set: `make up` starts one) ─────────────────────
DATABASE_URL=mongodb://localhost:27017/app?replicaSet=rs0&directConnection=true

# ── App ───────────────────────────────────────────────────────────────────────
# The web app's origin. Sign-in links point here, and it is the only Origin
# allowed to make cookie-bearing writes (CSRF guard).
APP_URL=https://localhost:5173
API_HOST=127.0.0.1
API_PORT=3000
# 0 = only existing users can sign in.
ENABLE_REGISTRATION=1
# Sign-in methods the API accepts (comma-separated: password, phone, email-code, email, google). Unset: all.
# Production uses "password" only; the web app's login form is phone + password.
# SIGN_IN_PROVIDERS=password

# ── Google sign-in (same client id for API and web) ───────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Email (SMTP). Unset in development = links and codes are logged instead. ─
# Local catcher: SMTP_HOST=localhost SMTP_PORT=1025 (no username) → http://localhost:8025
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@gmail.com
SMTP_FROM_NAME=Badminton Buddy

# ── SMS (Twilio, optional) ────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Object storage (S3-compatible: R2 in prod, SeaweedFS in dev) ──────────────
# Dev values match infra/seaweedfs/s3.json. The bucket needs CORS for PUT/GET from APP_URL.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=rally-dev
S3_ACCESS_KEY_ID=devaccesskey
S3_SECRET_ACCESS_KEY=devsecretkey-local-only

# Daily video-retention cron (Vercel sends it as a Bearer token): openssl rand -hex 32
CRON_SECRET=

# ── Web (Vite) ────────────────────────────────────────────────────────────────
# "local" = HTTPS via mkcert for the dev server.
IN_DEV=local
# Rally Analysis model files (ONNX). Dev: apps/web/public/models. Prod: a CORS-enabled CDN, trailing slash.
# VITE_MODEL_BASE_URL=https://models.example.com/
